<!DOCTYPE html>
<html lang="en">

    <%- include('../partials/head'); %>


<body class="container">

    <header>
        <%- include('../partials/header'); %>
    </header>

    <main>
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h1 class="h3 mb-1">Servicios</h1>
                        <p class="text-muted mb-0">Listado de servicios. Aquí podras ver, crear, editar y eliminar.</p>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="tablita" class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Duración (minutos)</th>
                                <th>Precio</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% servicios.forEach(function(servicio) { %>
                                <tr>
                                    <td><%= servicio.nombre %></td>
                                    <td><%= servicio.descripcion %></td>
                                    <td><%= servicio.duracionMinutos %></td>
                                    <td><%= servicio.precio %></td>
                                    <td class="text-end">
                                        <button
                                            type="button"
                                            class="btn btn-info btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalVerServicio"
                                            data-id="<%= servicio._id %>"
                                            data-nombre="<%= servicio.nombre %>"
                                            data-descripcion="<%= servicio.descripcion %>"
                                            data-duracion="<%= servicio.duracionMinutos %>"
                                            data-precio="<%= servicio.precio %>"
                                        >
                                            Ver
                                        </button>
                                        <button
                                            type="button"
                                            class="btn btn-warning btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarServicio"
                                            data-id="<%= servicio._id %>"
                                            data-nombre="<%= servicio.nombre %>"
                                            data-descripcion="<%= servicio.descripcion %>"
                                            data-duracion="<%= servicio.duracionMinutos %>"
                                            data-precio="<%= servicio.precio %>"
                                        >
                                            Editar
                                        </button>
                                        <button
                                            type="button"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminarServicio"
                                            data-id="<%= servicio._id %>"
                                            data-nombre="<%= servicio.nombre %>"
                                        >
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <div class="modal fade" id="modalVerServicio" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle del servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2"><strong>Nombre:</strong> <span id="verServicioNombre"></span></p>
                    <p class="mb-2"><strong>Descripción:</strong> <span id="verServicioDescripcion"></span></p>
                    <p class="mb-2"><strong>Duración:</strong> <span id="verServicioDuracion"></span> minutos</p>
                    <p class="mb-0"><strong>Precio:</strong> $ <span id="verServicioPrecio"></span></p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEditarServicio" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formEditarServicio" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Editar servicio</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="editarServicioNombre" class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="editarServicioNombre" name="nombre" required>
                        </div>
                        <div class="mb-3">
                            <label for="editarServicioDescripcion" class="form-label">Descripción</label>
                            <textarea class="form-control" id="editarServicioDescripcion" name="descripcion" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="editarServicioDuracion" class="form-label">Duración (minutos)</label>
                            <input type="number" class="form-control" id="editarServicioDuracion" name="duracionMinutos" min="0" step="1" required>
                        </div>
                        <div class="mb-3">
                            <label for="editarServicioPrecio" class="form-label">Precio</label>
                            <input type="number" class="form-control" id="editarServicioPrecio" name="precio" min="0" step="0.01" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminarServicio" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="formEliminarServicio" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Eliminar servicio</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">¿Seguro que deseas eliminar <strong id="eliminarServicioNombre"></strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <footer>
        <%- include('../partials/footer'); %>
    </footer>


<script src="//cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.3.8/js/dataTables.js"></script>
<script src="https://cdn.datatables.net/2.3.8/js/dataTables.bootstrap5.js"></script>
<script>
new DataTable('#tablita');

document.getElementById('modalVerServicio').addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    document.getElementById('verServicioNombre').textContent = button.getAttribute('data-nombre');
    document.getElementById('verServicioDescripcion').textContent = button.getAttribute('data-descripcion');
    document.getElementById('verServicioDuracion').textContent = button.getAttribute('data-duracion');
    document.getElementById('verServicioPrecio').textContent = button.getAttribute('data-precio');
});

document.getElementById('modalEditarServicio').addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    const id = button.getAttribute('data-id');

    document.getElementById('editarServicioNombre').value = button.getAttribute('data-nombre');
    document.getElementById('editarServicioDescripcion').value = button.getAttribute('data-descripcion');
    document.getElementById('editarServicioDuracion').value = button.getAttribute('data-duracion');
    document.getElementById('editarServicioPrecio').value = button.getAttribute('data-precio');
    document.getElementById('formEditarServicio').action = '/api/v1/servicios/' + id + '/actualizar';
});

document.getElementById('modalEliminarServicio').addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    const id = button.getAttribute('data-id');

    document.getElementById('eliminarServicioNombre').textContent = button.getAttribute('data-nombre');
    document.getElementById('formEliminarServicio').action = '/api/v1/servicios/' + id + '/eliminar';
});
</script>

</body>

</html>